  "forbiddenKeyPattern": "health|wellness|medical|sleep|hrv|heart|weight|body|checkin|calendar|title|description|prompt|response|content|message|note|token|secret|password|email|name|location|latitude|longitude|photo|image|minor|deletion"
}
