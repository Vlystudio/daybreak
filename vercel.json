{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/retention?write=1",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/cron/morning-sync",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/data-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 16 * * 0"
    },
    {
      "path": "/api/cron/account-deletion",
      "schedule": "*/10 * * * *"
    }
  ]
}
