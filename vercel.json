{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/morning-sync",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/data-sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 16 * * 0"
    }
  ]
}
