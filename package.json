{
  "name": "daybreak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check:migrations": "node scripts/check-migrations.mjs",
    "compliance:generate": "node scripts/generate-compliance-docs.mjs",
    "compliance:check": "node scripts/generate-compliance-docs.mjs --check",
    "verify:app-store-sections-1-8": "node scripts/verify-app-store-sections-1-8.mjs",
    "test:db": "node scripts/test-db-local.mjs",
    "test:db:preflight": "node scripts/test-db-local.mjs --preflight-only",
    "test:db:upgrades": "node scripts/test-db-upgrades.mjs",
    "migration:discover:static": "node scripts/discover-migration-state.mjs --read-only --expected-project-ref cybpuscssilbguypptxi --static-check",
    "staging:seed-deletion-user": "node scripts/staging-account-deletion.mjs seed",
    "staging:test-account-deletion": "node scripts/staging-account-deletion.mjs test",
    "staging:verify-deletion-residue": "node scripts/staging-account-deletion.mjs verify",
    "auth:verify-config": "node scripts/verify-supabase-auth-config.mjs --input config/auth/supabase-auth-evidence.template.json --evidence build/release-evidence/auth-provider-configuration.sanitized.json",
    "release:verify-production": "node scripts/verify-production-environment.mjs",
    "physical-device:validate": "node scripts/validate-physical-device-results.mjs",
    "physical-device:form": "node scripts/generate-physical-device-form.mjs",
    "ios:assets": "node scripts/generate-ios-assets.mjs",
    "ios:validate": "bash scripts/ios-release-validate.sh",
    "gen:types": "supabase gen types typescript --project-id cybpuscssilbguypptxi --schema public > src/lib/supabase/database.types.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,mjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@capacitor/core": "^6.2.1",
    "@capacitor/preferences": "^6.0.4",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-progress": "^1.1.9",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@sentry/nextjs": "^10.60.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "daybreak-healthkit": "file:native/healthkit",
    "fflate": "^0.8.3",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.12",
    "openai": "^6.42.0",
    "react": "19.2.4",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "recharts": "^3.8.1",
    "resend": "^6.14.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.6",
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "tar": "7.5.22"
  }
}
